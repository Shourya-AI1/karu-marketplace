# ─────────────────────────────────────────────────────────────
# Karu Marketplace — Environment Variables
# Copy to .env and fill in real values for production.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Karu

# Database (PostgreSQL). For zero-config local dev, SQLite is used automatically.
DATABASE_URL="postgresql://karu:karu@localhost:5432/karu?schema=public"

# Redis (rate limiting / caching). Falls back to in-memory if unset.
REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth
AUTH_SECRET="dev-secret-change-me-to-a-long-random-string"
AUTH_TRUST_HOST=true
# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (payments). Test mode keys work for development.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Resend (email)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Karu <hello@karu.market>"

# S3-compatible object storage
S3_ENDPOINT="https://s3.amazonaws.com"
S3_REGION="ap-south-1"
S3_BUCKET="karu-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_CDN_URL=""

# AI (optional — falls back to deterministic local heuristics)
OPENAI_API_KEY=""

# Monitoring
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Feature flags
NEXT_PUBLIC_ENABLE_3D=true
NEXT_PUBLIC_ENABLE_AUDIO=true
